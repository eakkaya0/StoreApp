<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-Commerce</title>

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        .navbar-brand {
            font-weight: bold;
            letter-spacing: .5px;
        }

        .product-card {
            transition: all .2s;
        }

        .product-card:hover {
            transform: scale(1.03);
            box-shadow: 0px 4px 16px rgba(0,0,0,0.12);
        }

        footer {
            background: #f5f5f5;
            padding: 25px 0;
        }

        /* Sepet Dropdown Stilleri */
        .cart-dropdown {
            min-width: 320px;
            max-height: 400px;
            overflow-y: auto;
        }

        .cart-item {
            padding: 10px 0;
            border-bottom: 1px solid #eee;
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        .cart-badge {
            background: #dc3545;
            color: white;
            border-radius: 10px;
            padding: 2px 8px;
            font-size: 12px;
            margin-left: 5px;
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">

            <!-- Logo -->
            <a class="navbar-brand" href="/">MyShop</a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar Content -->
            <div class="collapse navbar-collapse" id="mainNavbar">

                <ul class="navbar-nav ms-auto">

                    <!-- Ana Sayfa -->
                    <li class="nav-item">
                        <a class="nav-link" href="/">Ana Sayfa</a>
                    </li>

                    <!-- Ürünler -->
                    <li class="nav-item">
                        <a class="nav-link" href="/Products">Ürünler</a>
                    </li>

                    <!-- SEPET DROPDOWN -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="cartDropdown"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            🛒 Sepetim
                            <span id="cart-count" class="cart-badge">0</span>
                        </a>

                        <div class="dropdown-menu dropdown-menu-end p-3 cart-dropdown" aria-labelledby="cartDropdown">
                            <div id="cart-content">
                                <!-- Sepet içeriği buraya gelecek -->
                                <vc:cart-summary />
                            </div>
                        </div>
                    </li>
                </ul>

            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <main class="container my-4">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer>
        <div class="container text-center">
            <p class="mb-0">© @DateTime.Now.Year MyShop — Tüm Hakları Saklıdır.</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    
    <!-- Sepet güncelleme scripti -->
    <script>
        // Sayfa yüklendiğinde sepet sayısını güncelle
        document.addEventListener('DOMContentLoaded', function() {
            updateCartCount();
        });

        function updateCartCount() {
            // Sepetteki toplam ürün sayısını al
            const cartItems = document.querySelectorAll('.cart-item');
            let totalItems = 0;
            
            cartItems.forEach(item => {
                const quantityText = item.querySelector('.item-quantity')?.textContent;
                if (quantityText) {
                    const quantity = parseInt(quantityText.match(/\d+/)?.[0] || 0);
                    totalItems += quantity;
                }
            });

            // Badge'i güncelle
            const badge = document.getElementById('cart-count');
            if (badge) {
                badge.textContent = totalItems;
                badge.style.display = totalItems > 0 ? 'inline-block' : 'none';
            }
        }
    </script>
</body>

</html>