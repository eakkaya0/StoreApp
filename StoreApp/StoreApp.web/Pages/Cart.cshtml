@page
@model StoreApp.web.Pages.CartModel

@{
    ViewData["Title"] = "Sepet";
}

<h2 class="mb-4">Sepet</h2>

@if (Model.Cart.Items.Count == 0)
{
    <div class="alert alert-info">Sepetiniz boş.</div>
    <a href="/" class="btn btn-primary mt-3">Alışverişe Devam Et</a>
}
else
{
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Ürün</th>
                <th>Fiyat</th>
                <th>Adet</th>
                <th>Toplam</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Cart.Items)
            {
                <tr>
                    <td>@item.Product.Name</td>
                    <td>@item.Product.Price.ToString("c")</td>

                    <td class="d-flex gap-2 align-items-center">

                        <!-- Eksi Butonu -->
                        <form method="post" asp-page-handler="Decrease" asp-route-id="@item.Product.Id">
                            <button class="btn btn-sm btn-outline-danger">−</button>
                        </form>

                        <span>@item.Quantity</span>

                        <!-- Artı Butonu -->
                        <form method="post" asp-page-handler="Increase" asp-route-id="@item.Product.Id">
                            <button class="btn btn-sm btn-outline-success">+</button>
                        </form>
                    </td>

                    <td>@((item.Product.Price * item.Quantity).ToString("c"))</td>

                    <td>
                        <form method="post" asp-page-handler="Remove" asp-route-id="@item.Product.Id">
                            <button type="submit" class="btn btn-danger btn-sm">Kaldır</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mt-4">
        Toplam: <strong>@Model.Cart.ComputeTotalValue().ToString("c")</strong>
    </h4>

    <form method="post" asp-page-handler="Clear">
        <button type="submit" class="btn btn-warning mt-3">Sepeti Temizle</button>
    </form>

    <a href="/" class="btn btn-primary mt-3">Alışverişe Devam Et</a>
     <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary mt-3">Siparişi Tamamla</a>
}
