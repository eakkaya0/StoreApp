@model StoreApp.web.Models.ProductListViewModel

<!-- NAVBAR ile aynı container -->
<div class="container px-0 mt-4">
    <div class="row gx-3"> <!-- kolonlar arası gap -->

        <!-- SOL: Kategoriler (3 kolon) -->
        <div class="col-md-3">
            <h4>Kategoriler</h4>
            <ul class="list-group">
                <vc:categories-list />
            </ul>
        </div>

        <!-- SAĞ: Ürünler (9 kolon) -->
        <div class="col-md-9">
            @if (!Model.Products.Any())
            {
            <h3>Ürün Bulunamadı.</h3>
            }
            else
            {
            <div class="row">
                @foreach (var item in Model.Products)
                {
                <div class="col-12 mb-3">
                    <div class="card p-3 product-card">
                        <div class="d-flex justify-content-between align-items-start flex-wrap">
                            <div class="me-3">
                                <h4 class="mb-1">@item.Name</h4>
                                <p class="mb-1 text-muted">@item.Description</p>
                            </div>

                            <div class="text-end">
                                <div class="fw-bold text-success">
                                    @item.Price.ToString("C")
                                </div>

                                <form method="post" asp-page="/Cart">
                                    <input type="hidden" asp-for="@item.Id" name="Id" />
                                    <button type="submit" class="btn btn-primary btn-sm mt-2">
                                        Sepete Ekle
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                }

            </div>

            }

            @if(Model.PageInfo.TotalPages>1)
            {
            <div class="mt-3">
                <div page-model="@Model.PageInfo" page-action="Index" page-class="btn"
                    page-class-link="btn btn-outline-secondary me-1" page-class-active="btn btn-secondary">
                </div>
            </div>
            }
            <!-- Sayfalama -->


        </div>
    </div>
</div>