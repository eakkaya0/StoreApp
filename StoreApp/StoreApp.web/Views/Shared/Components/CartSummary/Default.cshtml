@model Cart

@if (Model == null || Model.Items.Count == 0)
{
    <div class="text-center py-3">
        <p class="text-muted mb-0">Sepetiniz boş</p>
        <a href="/Products" class="btn btn-primary btn-sm mt-2">Alışverişe Başla</a>
    </div>
}
else
{
    <!-- Sepet Ürünleri -->
    <div class="cart-items">
        @foreach (var item in Model.Items.Take(3))
        {
            <div class="cart-item">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="flex-grow-1">
                        <strong class="d-block">@item.Product.Name</strong>
                        <small class="text-muted item-quantity">
                            @item.Quantity adet × @item.Product.Price.ToString("C2") ₺
                        </small>
                    </div>
                    <div class="text-end ms-2">
                        <strong>@((item.Product.Price * item.Quantity).ToString("C2")) ₺</strong>
                    </div>
                </div>
            </div>
        }

        @if (Model.Items.Count > 3)
        {
            <div class="text-center py-2">
                <small class="text-muted">+@(Model.Items.Count - 3) ürün daha</small>
            </div>
        }
    </div>

    <!-- Toplam ve Butonlar -->
    <div class="mt-3 pt-3 border-top">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <strong>Toplam:</strong>
            <strong class="text-primary">@Model.ComputeTotalValue().ToString("C2") ₺</strong>
        </div>

        <div class="d-grid gap-2">
            <a href="/Cart" class="btn btn-primary btn-sm">Sepete Git</a>
            <a href="/Products" class="btn btn-outline-secondary btn-sm">Alışverişe Devam</a>
        </div>
    </div>
}